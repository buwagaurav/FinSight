# Copy to backend/.env and fill in only the keys for the providers you use.

# ---- API keys ----------------------------------------------------------------
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
DEEPSEEK_API_KEY=             # https://platform.deepseek.com
MOONSHOT_API_KEY=             # Kimi: https://platform.kimi.ai
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1   # any OpenAI-compatible server, e.g. a self-hosted model
# OPENAI_COMPAT_API_KEY=

# ---- Which model each feature uses: "provider:model-id" ------------------------
# Providers: anthropic, deepseek, moonshot, openai_compat. Default for everything: anthropic:claude-opus-5
# Model ids verified against the providers' docs on 2026-09-25:
#   deepseek:deepseek-flash      DeepSeek V4.1 Flash  - cheapest; tools + JSON; 1M context
#   deepseek:deepseek-v4-pro     DeepSeek V4 Pro      - stronger reasoning; tools + JSON
#   moonshot:kimi-k2.6           Kimi K2.6            - 256K context; tools + JSON mode
#   moonshot:kimi-k3             Kimi K3              - 1M context
#   anthropic:claude-sonnet-5    Claude Sonnet 5
#   anthropic:claude-opus-5      Claude Opus 5
# Decide with the eval, not the price list:
#   ../.venv/bin/python -m eval.run_eval --limit 20 --model deepseek:deepseek-flash
#FINSIGHT_MODEL=anthropic:claude-opus-5
#FINSIGHT_MODEL_ASSISTANT=anthropic:claude-sonnet-5
#FINSIGHT_MODEL_REPORT=anthropic:claude-sonnet-5
#FINSIGHT_MODEL_SUMMARY=deepseek:deepseek-flash   # note: scanned (image-only) PDFs need an anthropic model
#FINSIGHT_MODEL_SCREEN=deepseek:deepseek-flash

# ---- Database -------------------------------------------------------------------
# Unset: FinSight runs its own PostgreSQL 16 with data in backend/data/postgres/.
# Set to use any other PostgreSQL (Postgres.app, Neon, Supabase...):
#DATABASE_URL=postgresql://user:password@host:5432/finsight

# Background loader that keeps all NSE companies loaded and fresh (set 0 to disable)
#FINSIGHT_BACKGROUND_LOADER=1
