# Copy to web/.env.local for local development. On Netlify, set these under Site configuration > Environment variables.

# Public contact email shown on /privacy and /terms (until set, they link to the GitHub repository)
# NEXT_PUBLIC_CONTACT_EMAIL=finsight.support@example.com

# Where the website finds the API when deployed (leave unset locally; /api is forwarded to localhost:8010)
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Google sign-in (see DEPLOY.md, step 6). Leave all unset to run without accounts.
AUTH_URL=                    # the site's public address, e.g. https://finsight-in.netlify.app (required on Netlify)
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_GOOGLE_ID=              # from Google Cloud Console > Clients
AUTH_GOOGLE_SECRET=
FINSIGHT_API_JWT_SECRET=     # openssl rand -base64 32; the same value must be set on the API (Render)
